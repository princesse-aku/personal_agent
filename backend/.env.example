# --- LLM (RodiumAI, OpenAI-compatible) ---
RODIUMAI_API_KEY=rd_sk_YOUR_KEY
# RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4-5-20250929
DEFAULT_MODEL=openai/gpt-4o-mini
# MAX_TOKENS=2000

# --- Access ---
# Shared password the frontend must send (X-App-Password). Empty = no check (local dev only).
APP_PASSWORD=choose-a-long-random-password
APP_TIMEZONE=Africa/Lome

# --- Tools ---
TAVILY_API_KEY=tvly-YOUR_KEY
WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY

# --- Optional overrides ---
# DATABASE_URL=sqlite:///chat.db
# CORS_ORIGINS=http://localhost:5173   (only for local dev with Vite; not needed in production)

# --- Google (Calendar + Drive + Gmail send), via OAuth Playground: see GOOGLE_SETUP.md ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxx
# Optional but recommended with a personal account: limit the agent to one calendar and one folder
# GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# GOOGLE_DRIVE_FOLDER_ID=folder-id-from-the-folder-url

# --- Notion (integration token; share the pages with the integration) ---
NOTION_TOKEN=ntn_xxxxxxxx
# Optional: page under which new pages are created (id at the end of the page URL)
# NOTION_PARENT_PAGE_ID=
