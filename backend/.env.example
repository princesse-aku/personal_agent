# --- LLM (RodiumAI, OpenAI-compatible) ---
RODIUMAI_API_KEY=rd_sk_YOUR_KEY
# RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4-5-20250929
DEFAULT_MODEL=openai/gpt-4o-mini
# MAX_TOKENS=2000

# --- Access ---
# Shared password the frontend must send (X-App-Password). Empty = no check (local dev only).
APP_PASSWORD=choose-a-long-random-password
APP_TIMEZONE=Africa/Lome

# --- Tools ---
TAVILY_API_KEY=tvly-YOUR_KEY
WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY

# --- Optional overrides ---
# DATABASE_URL=sqlite:///chat.db
# CORS_ORIGINS=http://localhost:5173   (only for local dev with Vite; not needed in production)
